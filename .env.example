# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase → Project Settings → API).
# Sem essas variáveis o site roda em MODO DEMONSTRAÇÃO (dados salvos só no navegador).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
# No Lovable Cloud o nome é VITE_SUPABASE_PUBLISHABLE_KEY — os dois funcionam.
